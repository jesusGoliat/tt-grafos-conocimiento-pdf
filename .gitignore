# Artefactos de la evaluación del CER.
# Se publican los resultados derivados (muestra, referencias, content_list.json,
# CSV y manifiesto), que permiten recalcular las métricas sin red.
# NO se publican las páginas de OmniDocBench ni las imágenes: el conjunto tiene
# licencia solo para investigación. Se regeneran con scripts/omnidocbench/ y run.py.
backend/scripts/omnidocbench/resultados_cer_*/pdfs/
