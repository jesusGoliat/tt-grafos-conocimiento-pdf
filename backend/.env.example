# Copia este archivo a .env y coloca tu token de https://mineru.net (API Management)
MINERU_API_TOKEN=

# pipeline (por defecto) o vlm (más preciso, más lento)
MINERU_MODEL_VERSION=pipeline
# Familia de OCR: latin (español, inglés...), ch, en, ...
MINERU_LANGUAGE=latin
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_IS_OCR=false
MINERU_POLL_INTERVAL_S=3
MINERU_POLL_TIMEOUT_S=900

MAX_UPLOAD_MB=50
# CORS_ORIGINS=["http://localhost:5173"]
